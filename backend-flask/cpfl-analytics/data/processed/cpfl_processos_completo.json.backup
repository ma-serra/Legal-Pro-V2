    "Tipo de Ação": "Ação de Indenização",
    "Causa-Raiz": "Alteração de titularidade",
    "Fase": "Instrutória",
    "Decisão (1ª Instância)": "Desfavorável",
    "Decisão (2ª Instância)": "Sem decisão",
    "Acordo/Defesa": "Defesa",
    "Possui Liminar?": "Sim",
    "Objeto": "Atendimento",
    "Resultado final": null,
    "Estado": "RS",
