    "Valor Envolvido Atual - Passiva": 21553.97,
    "Valor Provável (atual) - Passiva": 0.0,
    "Valor possível (atual) - Passiva": 7827.55,
    "Valor Remoto (atual) - Passiva": 13726.41,
    "Classificação - Passiva": "Possível",
