    "Valor Envolvido Atual - Passiva": 23573.56,
    "Valor Provável (atual) - Passiva": 0.0,
    "Valor possível (atual) - Passiva": 18735.48,
    "Valor Remoto (atual) - Passiva": 4838.08,
    "Classificação - Passiva": "Possível",
    "Valor Principal": 30000.0,
