    "Órgão Desdobramento": "3ª Vara Cível - Justiça Estadual do Rio Grande do Sul.",
    "Valor Envolvido Atual - Passiva": 295756.36,
    "Valor Provável (atual) - Passiva": 13374.1,
    "Valor possível (atual) - Passiva": 0.0,
    "Valor Remoto (atual) - Passiva": 83876.13,
