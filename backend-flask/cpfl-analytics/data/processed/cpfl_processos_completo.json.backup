  {
    "ID Processo": 287485,
    "Número do Processo": "1001604-62.2023.8.05.0250",
    "Cadastro Interno": "100122496",
    "Situação": "Ativo",
    "Data criação": "2023-08-04",
    "Data de citação": "NaT",
    "Distribuído em": "2023-07-31",
    "Na fase desde": "2024-02-29",
    "Dias sem Movimentação": 82,
    "Data última movimentação": "2025-06-09",
    "Tipo de Ação": "Reparação de danos",
    "Causa-Raiz": "Condições do fornecimento",
    "Fase": "Recursal - 2ª instância",
    "Decisão (1ª Instância)": "Desfavorável",
    "Decisão (2ª Instância)": "Sem decisão",
    "Acordo/Defesa": "Defesa",
    "Possui Liminar?": "Não",
