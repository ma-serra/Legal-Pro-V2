    "Valor Envolvido Atual - Passiva": 31914.95,
    "Valor Provável (atual) - Passiva": 0.0,
    "Valor possível (atual) - Passiva": 18115.16,
    "Valor Remoto (atual) - Passiva": 13799.79,
    "Classificação - Passiva": "Possível",
    "Valor Principal": 14200.0,
