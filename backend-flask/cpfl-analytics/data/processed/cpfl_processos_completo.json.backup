    "Valor Envolvido Atual - Passiva": 25805.51,
    "Valor Provável (atual) - Passiva": 0.0,
    "Valor possível (atual) - Passiva": 6451.37,
    "Valor Remoto (atual) - Passiva": 19354.13,
    "Classificação - Passiva": "Possível",
    "Valor Principal": 20000.0,
