    "Tipo de Ação": "Declaratória de inexistência de débito",
    "Causa-Raiz": "Desconhece o débito",
    "Fase": "Instrutória",
    "Decisão (1ª Instância)": "Em andamento",
    "Decisão (2ª Instância)": "Sem decisão",
    "Acordo/Defesa": "Defesa",
    "Possui Liminar?": "Sim",
    "Objeto": "Protesto",
