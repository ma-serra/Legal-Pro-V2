    "Causa-Raiz": "Demora no restabelecimento",
    "Fase": "Recursal - 2ª instância",
    "Decisão (1ª Instância)": "Desfavorável",
    "Decisão (2ª Instância)": "Favorável",
    "Acordo/Defesa": "Defesa",
    "Possui Liminar?": "Não",
