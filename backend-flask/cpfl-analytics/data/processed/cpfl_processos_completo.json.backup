    "Valor Envolvido Atual - Passiva": 42011.95,
    "Valor Provável (atual) - Passiva": 0.0,
    "Valor possível (atual) - Passiva": 16445.45,
    "Valor Remoto (atual) - Passiva": 25566.5,
    "Classificação - Passiva": "Possível",
