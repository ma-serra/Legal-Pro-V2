                    <div class="model-metrics">
                        <div class="metric">
                            <span class="metric-value">89-99%</span>
                            <div class="metric-label">Precisão</div>
                        </div>
                        <div class="metric">
                            <span class="metric-value">Variável</span>
                            <div class="metric-label">Volume</div>
                        </div>
                        <div class="metric">
                            <span class="metric-value">Experimental</span>
