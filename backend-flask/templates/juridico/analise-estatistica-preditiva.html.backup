    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Carregar modelos salvos ao inicializar a página
        document.addEventListener('DOMContentLoaded', function() {
            carregarModelosSalvos();
        });

        async function carregarModelosSalvos() {
            try {
                const response = await fetch('/api/estatistica/listar-modelos', {
                    credentials: 'include',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                });
                
                // Se retornou redirecionamento para login
                if (response.status === 302 || response.redirected) {
                    console.log('Usuário não autenticado - seção de modelos não será exibida');
                    return;
                }
                
                // Verificar se a resposta está retornando HTML (redirecionamento para login)
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('text/html')) {
                    console.log('Usuário não autenticado - necessário fazer login');
                    return;
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const resultado = await response.json();
                
                if (resultado.sucesso && resultado.modelos && resultado.modelos.length > 0) {
                    exibirModelosSalvos(resultado.modelos);
                    document.getElementById('modelos-salvos-section').style.display = 'block';
                } else if (resultado.sucesso && resultado.modelos && resultado.modelos.length === 0) {
                    // Usuário logado mas sem modelos salvos - não mostrar seção
                    console.log('Usuário logado mas sem modelos salvos');
                }
            } catch (error) {
                console.error('Erro ao carregar modelos salvos:', error);
                // Não mostrar erro para o usuário se for problema de autenticação
            }
        }

        function exibirModelosSalvos(modelos) {
            const container = document.getElementById('modelos-salvos-container');
            container.innerHTML = '';

            modelos.forEach(modelo => {
                const card = criarCardModeloSalvo(modelo);
                container.appendChild(card);
            });
        }

        function criarCardModeloSalvo(modelo) {
            const div = document.createElement('div');
            div.className = 'col-md-6 col-lg-4';
            
            const tipoFormatado = formatarTipoModelo(modelo.tipo);
            const dataFormatada = new Date(modelo.criado_em).toLocaleString('pt-BR');
            
            div.innerHTML = `
                <div class="saved-model-card" onclick="carregarModelo(${modelo.id}, '${modelo.tipo}')">
                    <div class="saved-model-header">
                        <div class="saved-model-name">${modelo.nome}</div>
                        <div class="saved-model-type">${tipoFormatado}</div>
                    </div>
                    <div class="saved-model-description">
                        ${modelo.descricao || 'Sem descrição'}
                    </div>
                    <div class="saved-model-meta">
                        <span><i class="fas fa-calendar"></i> ${dataFormatada}</span>
                        <div class="saved-model-actions">
                            <button class="btn-saved-model btn-load-model" onclick="event.stopPropagation(); carregarModelo(${modelo.id}, '${modelo.tipo}')">
                                <i class="fas fa-play"></i> Usar
                            </button>
                            <button class="btn-saved-model btn-edit-model" onclick="event.stopPropagation(); editarModelo(${modelo.id}, '${modelo.tipo}', '${modelo.nome}', '${modelo.descricao || ''}')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-saved-model btn-delete-model" onclick="event.stopPropagation(); excluirModelo(${modelo.id})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            return div;
        }

        function formatarTipoModelo(tipo) {
            const tipos = {
                'regressao': 'Regressão',
                'arvore': 'Árvore de Decisão',
                'neurais': 'Redes Neurais',
                'temporais': 'Séries Temporais',
                'sobrevivencia': 'Sobrevivência',
                'adaptativo': 'Adaptativo',
                'reforco': 'Reforço',
                'ensemble': 'Ensemble',
                'meta-learning': 'Meta-Learning'
            };
            return tipos[tipo] || tipo;
        }

        async function carregarModelo(modeloId, tipo) {
            try {
                const response = await fetch(`/api/estatistica/carregar-modelo/${modeloId}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const resultado = await response.json();
                
                if (resultado.sucesso) {
                    const templateUrl = `/juridico/modelos-estatisticos/template-${tipo}?modelo_id=${modeloId}`;
                    window.location.href = templateUrl;
                } else {
                    mostrarErroModelo(resultado.erro || 'Erro ao carregar modelo');
                }
            } catch (error) {
                console.error('Erro ao carregar modelo:', error);
                mostrarErroModelo('Erro ao carregar modelo');
            }
        }

        async function excluirModelo(modeloId) {
            if (!confirm('Tem certeza que deseja excluir este modelo? Esta ação não pode ser desfeita.')) {
                return;
            }

            try {
                const response = await fetch(`/api/estatistica/excluir-modelo/${modeloId}`, {
                    method: 'DELETE'
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const resultado = await response.json();
                
                if (resultado.sucesso) {
                    mostrarSucessoModelo('Modelo excluído com sucesso!');
                    carregarModelosSalvos();
                } else {
                    mostrarErroModelo(resultado.erro || 'Erro ao excluir modelo');
                }
            } catch (error) {
                console.error('Erro ao excluir modelo:', error);
                mostrarErroModelo('Erro ao excluir modelo');
            }
        }

        function mostrarSucessoModelo(mensagem) {
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-bg-success border-0';
            toast.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body"><i class="fas fa-check-circle me-2"></i>${mensagem}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast, { delay: 4000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        function mostrarErroModelo(mensagem) {
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-bg-danger border-0';
            toast.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body"><i class="fas fa-exclamation-circle me-2"></i>${mensagem}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast, { delay: 5000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        async function editarModelo(modeloId, tipoModelo, nomeAtual, descricaoAtual) {
            try {
                // Carregar dados completos do modelo e abrir template correspondente
                const response = await fetch(`/api/estatistica/carregar-modelo/${modeloId}`);
                const dados = await response.json();
                
                if (!dados.sucesso) {
                    mostrarErroModelo('Erro ao carregar dados do modelo');
                    return;
                }
                
                // Templates disponíveis
                const templates = {
                    'regressao': '/juridico/modelos-estatisticos/template-regressao',
                    'arvore': '/juridico/modelos-estatisticos/template-arvore', 
                    'neurais': '/juridico/modelos-estatisticos/template-neurais',
                    'temporais': '/juridico/modelos-estatisticos/template-temporais',
                    'sobrevivencia': '/juridico/modelos-estatisticos/template-sobrevivencia'
                };
                
                if (templates[tipoModelo]) {
                    // Armazenar dados do modelo no localStorage para carregar no template
                    localStorage.setItem('modeloParaEditar', JSON.stringify(dados.modelo));
                    // Redirecionar para o template correspondente em modo de edição
                    window.location.href = templates[tipoModelo] + '?edit=' + modeloId;
                } else {
                    mostrarErroModelo('Tipo de modelo não suportado: ' + tipoModelo);
                }
                
            } catch (error) {
                console.error('Erro ao editar modelo:', error);
                mostrarErroModelo('Erro ao editar modelo');
            }
        }

        // Função para edição simples (apenas nome e descrição) - pode ser usada no futuro
        async function editarNomeDescricaoModelo(modeloId, tipoModelo, nomeAtual, descricaoAtual) {
            try {
                const response = await fetch(`/api/estatistica/carregar-modelo/${modeloId}`);
                const dados = await response.json();
                
                if (!dados.sucesso) {
                    mostrarErroModelo('Erro ao carregar dados do modelo');
                    return;
                }
                
                // Criar modal de edição simples (apenas nome e descrição)
                const modalHtml = `
                    <div class="modal fade" id="modalEditarModelo" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content" style="background: #2c3e50; border: 1px solid rgba(255, 255, 255, 0.2);">
                                <div class="modal-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                    <h5 class="modal-title text-white">
                                        <i class="fas fa-edit me-2"></i>Editar Modelo
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <form id="formEditarModelo">
                                        <div class="mb-3">
                                            <label class="form-label text-white">Nome do Modelo:</label>
                                            <input type="text" class="form-control" id="edit_nome_modelo" 
                                                   value="${dados.modelo.nome || ''}" required
                                                   style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label text-white">Descrição:</label>
                                            <textarea class="form-control" id="edit_descricao_modelo" rows="3"
                                                      style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;"
                                                      placeholder="Descrição do modelo">${dados.modelo.descricao || ''}</textarea>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="fas fa-times me-1"></i>Cancelar
                                    </button>
                                    <button type="button" class="btn btn-warning" onclick="salvarEdicaoModelo(${modeloId})">
                                        <i class="fas fa-save me-1"></i>Salvar Alterações
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                
                // Remover modal existente se houver
                const existingModal = document.getElementById('modalEditarModelo');
                if (existingModal) {
                    existingModal.remove();
                }
                
                // Adicionar modal ao DOM
                document.body.insertAdjacentHTML('beforeend', modalHtml);
                
                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('modalEditarModelo'));
                modal.show();
                
                // Focar no campo nome
                setTimeout(() => {
                    document.getElementById('edit_nome_modelo').focus();
                }, 300);
                
            } catch (error) {
                console.error('Erro ao editar modelo:', error);
                mostrarErroModelo('Erro ao editar modelo');
            }
        }

        async function salvarEdicaoModelo(modeloId) {
            try {
                const nome = document.getElementById('edit_nome_modelo').value.trim();
                const descricao = document.getElementById('edit_descricao_modelo').value.trim();
                
                if (!nome) {
                    mostrarErroModelo('Nome do modelo é obrigatório');
                    return;
                }
                
                const response = await fetch(`/api/estatistica/editar-modelo/${modeloId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        nome: nome,
                        descricao: descricao
                    })
                });
                
                const resultado = await response.json();
                
                if (resultado.sucesso) {
                    mostrarSucessoModelo('Modelo editado com sucesso!');
                    
                    // Fechar modal de edição
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalEditarModelo'));
                    modal.hide();
                    
                    // Recarregar lista de modelos
                    carregarModelosSalvos();
                } else {
                    mostrarErroModelo(resultado.erro || 'Erro ao editar modelo');
                }
            } catch (error) {
                console.error('Erro ao editar modelo:', error);
                mostrarErroModelo('Erro ao editar modelo');
            }
        }

        // Função separada para editar configurações completas (se necessário no futuro)
        async function editarConfiguracaoModelo(modeloId, tipoModelo) {
            // Esta função pode ser implementada para casos específicos onde
            // queremos editar as configurações completas do modelo
            const templates = {
                'regressao': '/juridico/modelos-estatisticos/template-regressao',
                'arvore': '/juridico/modelos-estatisticos/template-arvore',
                'neurais': '/juridico/modelos-estatisticos/template-neurais',
                'temporais': '/juridico/modelos-estatisticos/template-temporais',
                'sobrevivencia': '/juridico/modelos-estatisticos/template-sobrevivencia'
            };
            
            if (templates[tipoModelo]) {
                // Carregar dados do modelo
                const response = await fetch(`/api/estatistica/carregar-modelo/${modeloId}`);
                if (response.ok) {
                    const resultado = await response.json();
                    if (resultado.sucesso) {
                        // Armazenar dados do modelo no localStorage para carregar no template
                        localStorage.setItem('modeloParaEditar', JSON.stringify(resultado.modelo));
                        // Redirecionar para o template correspondente
                        window.location.href = templates[tipoModelo] + '?edit=' + modeloId;
                    }
                }
            }
        }
                        <div class="mb-3">
                            <label class="form-label text-white">Variável Dependente:</label>
                            <input type="text" class="form-control" id="edit_variavel_dependente" 
                                   value="${configuracao.variavel_dependente || ''}"
                                   style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Variáveis Independentes:</label>
                            <textarea class="form-control" id="edit_variaveis_independentes" rows="3"
                                      style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;"
                                      placeholder="Uma variável por linha">${(configuracao.variaveis_independentes || []).join('\\n')}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Tipo de Regressão:</label>
                            <select class="form-select" id="edit_tipo_regressao" 
                                    style="background: #7b8c93; border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                                <option value="linear" ${configuracao.tipo_regressao === 'linear' ? 'selected' : ''}>Linear</option>
                                <option value="logistica" ${configuracao.tipo_regressao === 'logistica' ? 'selected' : ''}>Logística</option>
                                <option value="polinomial" ${configuracao.tipo_regressao === 'polinomial' ? 'selected' : ''}>Polinomial</option>
                                <option value="multipla" ${configuracao.tipo_regressao === 'multipla' ? 'selected' : ''}>Múltipla</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Método de Validação:</label>
                            <select class="form-select" id="edit_metodo_validacao"
                                    style="background: #7b8c93; border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                                <option value="holdout" ${configuracao.metodo_validacao === 'holdout' ? 'selected' : ''}>Hold-out</option>
                                <option value="cross_validation" ${configuracao.metodo_validacao === 'cross_validation' ? 'selected' : ''}>Validação Cruzada</option>
                                <option value="bootstrap" ${configuracao.metodo_validacao === 'bootstrap' ? 'selected' : ''}>Bootstrap</option>
                            </select>
                        </div>
                    `;
                } else if (tipoModelo === 'arvore') {
                    camposEspecificos = `
                        <div class="mb-3">
                            <label class="form-label text-white">Variável Alvo:</label>
                            <input type="text" class="form-control" id="edit_variavel_alvo" 
                                   value="${configuracao.variavel_alvo || ''}"
                                   style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Atributos Preditivos:</label>
                            <textarea class="form-control" id="edit_atributos_preditivos" rows="3"
                                      style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;"
                                      placeholder="Um atributo por linha">${(configuracao.atributos_preditivos || []).join('\\n')}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Critério de Divisão:</label>
                            <select class="form-select" id="edit_criterio_divisao"
                                    style="background: #7b8c93; border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                                <option value="gini" ${configuracao.criterio_divisao === 'gini' ? 'selected' : ''}>Gini</option>
                                <option value="entropy" ${configuracao.criterio_divisao === 'entropy' ? 'selected' : ''}>Entropia</option>
                                <option value="chi_square" ${configuracao.criterio_divisao === 'chi_square' ? 'selected' : ''}>Chi-quadrado</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Profundidade Máxima:</label>
                            <input type="number" class="form-control" id="edit_profundidade_maxima" 
                                   value="${configuracao.profundidade_maxima || ''}"
                                   style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;">
                        </div>
                    `;
                }
                // Adicionar mais tipos conforme necessário...
                
                const modalHtml = `
                    <div class="modal fade" id="modalEditarModelo" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content" style="background: #2c3e50; border: 1px solid rgba(255, 255, 255, 0.2);">
                                <div class="modal-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                    <h5 class="modal-title text-white">
                                        <i class="fas fa-edit me-2"></i>Editar Modelo - ${tipoModelo.charAt(0).toUpperCase() + tipoModelo.slice(1)}
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-white mb-3"><i class="fas fa-info-circle me-2"></i>Informações Gerais</h6>
                                            <div class="mb-3">
                                                <label for="editNomeModelo" class="form-label text-white">Nome do Modelo:</label>
                                                <input type="text" class="form-control" id="editNomeModelo" value="${nomeAtual}"
                                                       style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;"
                                                       placeholder="Digite o nome do modelo...">
                                            </div>
                                            <div class="mb-3">
                                                <label for="editDescricaoModelo" class="form-label text-white">Descrição:</label>
                                                <textarea class="form-control" id="editDescricaoModelo" rows="3" 
                                                          placeholder="Descrição detalhada do modelo..."
                                                          style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: white;">${descricaoAtual}</textarea>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-white mb-3"><i class="fas fa-cogs me-2"></i>Configurações do Modelo</h6>
                                            ${camposEspecificos}
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="button" class="btn btn-warning" onclick="salvarEdicaoModelo(${modeloId}, '${tipoModelo}')">
                                        <i class="fas fa-save me-1"></i>Salvar Alterações
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                
                // Remover modal existente se houver
                const existingModal = document.getElementById('modalEditarModelo');
                if (existingModal) {
                    existingModal.remove();
                }
                
                // Adicionar modal ao DOM
                document.body.insertAdjacentHTML('beforeend', modalHtml);
                
                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('modalEditarModelo'));
                modal.show();
                
                // Focar no campo nome
                document.getElementById('editNomeModelo').focus();
                
            } catch (error) {
                console.error('Erro ao carregar modelo para edição:', error);
                mostrarErroModelo('Erro ao carregar dados do modelo');
            }
        }

        async function salvarEdicaoModelo(modeloId, tipoModelo) {
            try {
                const nome = document.getElementById('editNomeModelo').value.trim();
                const descricao = document.getElementById('editDescricaoModelo').value.trim();
                
                if (!nome) {
                    mostrarErroModelo('Por favor, informe um nome para o modelo');
                    return;
                }
                
                // Coletar dados específicos do tipo de modelo
                let configuracao = {};
                
                if (tipoModelo === 'regressao') {
                    const variaveisIndep = document.getElementById('edit_variaveis_independentes').value;
                    configuracao = {
                        variavel_dependente: document.getElementById('edit_variavel_dependente').value.trim(),
                        variaveis_independentes: variaveisIndep.split('\n').filter(v => v.trim()),
                        tipo_regressao: document.getElementById('edit_tipo_regressao').value,
                        metodo_validacao: document.getElementById('edit_metodo_validacao').value
                    };
                } else if (tipoModelo === 'arvore') {
                    const atributosPred = document.getElementById('edit_atributos_preditivos').value;
                    configuracao = {
                        variavel_alvo: document.getElementById('edit_variavel_alvo').value.trim(),
                        atributos_preditivos: atributosPred.split('\n').filter(a => a.trim()),
                        criterio_divisao: document.getElementById('edit_criterio_divisao').value,
                        profundidade_maxima: parseInt(document.getElementById('edit_profundidade_maxima').value) || null
                    };
                }
                
                const dadosEdicao = {
                    nome: nome,
                    descricao: descricao || '',
                    configuracao: configuracao
                };
                
                const response = await fetch(`/api/estatistica/editar-modelo/${modeloId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(dadosEdicao)
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const resultado = await response.json();
                
                if (resultado.sucesso) {
                    mostrarSucessoModelo(`Modelo "${nome}" editado com sucesso!`);
                    
                    // Fechar modal de edição
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalEditarModelo'));
                    modal.hide();
                    
                    // Recarregar lista de modelos
                    carregarModelosSalvos();
                } else {
                    mostrarErroModelo(resultado.erro || 'Erro ao editar modelo');
                }
            } catch (error) {
                console.error('Erro ao editar modelo:', error);
                mostrarErroModelo('Erro ao editar modelo');
            }
        }

        // Função para acessar templates de modelos
        function acessarModelo(tipoModelo) {
            // Templates disponíveis
            const templates = {
                'regressao': '/juridico/modelos-estatisticos/template-regressao',
                'arvore': '/juridico/modelos-estatisticos/template-arvore', 
                'neurais': '/juridico/modelos-estatisticos/template-neurais',
                'temporais': '/juridico/modelos-estatisticos/template-temporais',
                'sobrevivencia': '/juridico/modelos-estatisticos/template-sobrevivencia',
                'adaptativo': '/juridico/modelos-estatisticos/template-adaptativo',
                'reforco': '/juridico/modelos-estatisticos/template-reforco',
                'ensemble': '/juridico/modelos-estatisticos/template-ensemble',
                'meta-learning': '/juridico/modelos-estatisticos/template-meta-learning'
            };
            
            if (templates[tipoModelo]) {
                window.location.href = templates[tipoModelo];
            } else {
                mostrarErroModelo('Template não encontrado para: ' + tipoModelo);
            }
        }

        function abrirTemplate(tipoModelo) {
            // Criar modal dinâmico para seleção do modelo
            const modalHTML = `
                <div class="modal fade" id="modeloModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content" style="background: #2c3e50; color: white;">
                            <div class="modal-header" style="border-bottom: 1px solid #34495e;">
                                <h5 class="modal-title">
                                    <i class="fas fa-chart-bar"></i> 
                                    Acessar Modelo: ${tipoModelo.charAt(0).toUpperCase() + tipoModelo.slice(1)}
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>Selecione como deseja acessar o modelo estatístico:</p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card bg-dark text-white h-100">
                                            <div class="card-body text-center">
                                                <i class="fas fa-list-alt fa-2x mb-3 text-primary"></i>
                                                <h6>Template Individual</h6>
                                                <p class="small">Acesse o formulário específico do modelo</p>
                                                <button class="btn btn-primary btn-sm w-100" onclick="abrirTemplate('${tipoModelo}')">
                                                    Abrir Template
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card bg-dark text-white h-100">
                                            <div class="card-body text-center">
                                                <i class="fas fa-list fa-2x mb-3 text-success"></i>
                                                <h6>Lista de Processos</h6>
                                                <p class="small">Veja processos existentes e aplique o modelo</p>
                                                <button class="btn btn-success btn-sm w-100" onclick="abrirListaProcessos()">
                                                    Ver Processos
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remover modal anterior se existir
            const existingModal = document.getElementById('modeloModal');
            if (existingModal) {
                existingModal.remove();
            }
            
            // Adicionar novo modal
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // Mostrar modal
            const modal = new bootstrap.Modal(document.getElementById('modeloModal'));
            modal.show();
        }
        
        function abrirTemplate(tipo) {
            let url;
            switch(tipo) {
                case 'regressao':
                    url = '/juridico/modelos-estatisticos/template-regressao';
                    break;
                case 'arvore':
                    url = '/juridico/modelos-estatisticos/template-arvore-decisao';
                    break;
                case 'neurais':
                    url = '/juridico/modelos-estatisticos/template-redes-neurais';
                    break;
                case 'temporais':
                    url = '/juridico/modelos-estatisticos/template-series-temporais';
                    break;
                case 'sobrevivencia':
                    url = '/juridico/modelos-estatisticos/template-sobrevivencia';
                    break;
                case 'adaptativo':
                    url = '/juridico/modelos-estatisticos/template-adaptativo';
                    break;
                case 'reforco':
                    url = '/juridico/modelos-estatisticos/template-reforco';
                    break;
                case 'ensemble':
                    url = '/juridico/modelos-estatisticos/template-ensemble';
                    break;
                case 'meta-learning':
                    url = '/juridico/modelos-estatisticos/template-meta-learning';
                    break;
                default:
                    url = '/juridico/analise-estatistica-preditiva';
            }
            window.open(url, '_blank');
            
            // Fechar modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('modeloModal'));
            modal.hide();
        }
        
        function abrirListaProcessos() {
            window.location.href = '/processos/lista';
        }
        
        // Efeito de parallax suave no mouse
        document.addEventListener('mousemove', function(e) {
            const cards = document.querySelectorAll('.model-card');
            cards.forEach(card => {
                const rect = card.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                
                const deltaX = (e.clientX - centerX) * 0.01;
                const deltaY = (e.clientY - centerY) * 0.01;
                
                card.style.transform = `translateY(-8px) rotateX(${deltaY}deg) rotateY(${deltaX}deg)`;
            });
        });
        
        // Reset das transformações quando o mouse sai
        document.addEventListener('mouseleave', function() {
            const cards = document.querySelectorAll('.model-card');
            cards.forEach(card => {
                card.style.transform = '';
            });
        });
    </script>
</body>
</html>