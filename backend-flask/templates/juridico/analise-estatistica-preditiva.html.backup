                </div>

                <!-- Card 8: Algoritmo Ensemble -->
                <div class="model-card">
                    <div class="model-badge">Multi-Modelo</div>
                    <i class="fas fa-layer-group model-icon"></i>
                    <div class="model-title">Algoritmo Ensemble</div>
                    <div class="model-description">
                        Combinação inteligente de múltiplos modelos que trabalham em conjunto para maximizar precisão através de consenso e diversidade preditiva.
