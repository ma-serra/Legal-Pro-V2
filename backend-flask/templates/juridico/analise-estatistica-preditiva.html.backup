                <!-- Card 10: Modelos Jurídicos Bayesianos -->
                <div class="model-card">
                    <div class="model-badge">Especializado</div>
                    <i class="fas fa-balance-scale model-icon"></i>
                    <div class="model-title">Modelos Jurídicos</div>
                    <div class="model-description">
                        Sistema especializado em análise jurídica bayesiana com recomendações de defesa baseadas em dados históricos e especificidade por área jurídica.
                    </div>
                    
                    <div class="model-features">
                        <div class="feature-item">
                            <i class="fas fa-check"></i>
                            <span>Análise Bayesiana Jurídica</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-check"></i>
