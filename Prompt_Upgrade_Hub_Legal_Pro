import React from 'react';
import { Controller } from 'react-hook-form';
import CurrencyInput from './CurrencyInput';
import PercentageInput from './PercentageInput';
import MultiSelectTeses from './MultiSelectTeses';
import { FormField } from '../../../types/processos/formulario.types';

interface FieldRendererProps {
  field: FormField;
  control: any;
  errors: any;
}

const FieldRenderer: React.FC<FieldRendererProps> = ({ field, control, errors }) => {
  const error = errors[field.name];
  const isRequired = field.validation?.required;

  const renderField = () => {
    switch (field.type) {
      case 'text':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <input
                {...formField}
                type="text"
                className={`mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 ${
                  error ? 'border-red-500' : ''
                }`}
                placeholder={field.label}
              />
            )}
          />
        );

      case 'currency':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <CurrencyInput
                value={formField.value}
                onChange={formField.onChange}
                error={!!error}
              />
            )}
          />
        );

      case 'percentage':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <PercentageInput
                value={formField.value}
                onChange={formField.onChange}
                error={!!error}
              />
            )}
          />
        );

      case 'date':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <input
                {...formField}
                type="date"
                className={`mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 ${
                  error ? 'border-red-500' : ''
                }`}
              />
            )}
          />
        );

      case 'select':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <select
                {...formField}
                className={`mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 ${
                  error ? 'border-red-500' : ''
                }`}
              >
                <option value="">Selecione...</option>
                {field.options?.map(option => (
                  <option key={option.value} value={option.value}>
                    {option.label}
                  </option>
                ))}
              </select>
            )}
          />
        );

      case 'multiselect':
        return (
          <Controller
            name={field.name}
            control={control}
            render={({ field: formField }) => (
              <MultiSelectTeses
                value={formField.value || []}
                onChange={formField.onChange}
                endpoint={field.options_endpoint}
                error={!!error}
              />
            )}
          />
        );

      default:
        return null;
    }
  };

  return (
    <div className={field.type === 'multiselect' ? 'md:col-span-2' : ''}>
      <label className="block text-sm font-medium text-gray-700">
        {field.label}
        {isRequired && <span className="text-red-500 ml-1">*</span>}
      </label>
      
      {renderField()}
      
      {field.description && (
        <p className="mt-1 text-sm text-gray-500">{field.description}</p>
      )}
      
      {error && (
        <p className="mt-1 text-sm text-red-600">{error.message}</p>
      )}
    </div>
  );
};

