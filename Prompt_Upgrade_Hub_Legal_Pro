python# modules/processos/models.py
from sqlalchemy import Column, Integer, String, Text, Date, Numeric, Boolean, ForeignKey, TIMESTAMP
from sqlalchemy.dialects.postgresql import UUID, JSONB
from sqlalchemy.orm import relationship
from datetime import datetime
import uuid

from database import Base

class Processo(Base):
    __tablename__ = 'processos'
    
    # Identificação
    id_processo = Column(Integer, primary_key=True)
    uuid = Column(UUID(as_uuid=True), default=uuid.uuid4, unique=True, nullable=False)
    tenant_id = Column(Integer, ForeignKey('tenants.id_tenant'), nullable=False)
    
    # Dados Básicos
    numero_cnj = Column(String(25))
    pasta = Column(String(50))
    status_id = Column(Integer, ForeignKey('status_processo.id_status'), nullable=False)
    natureza_id = Column(Integer, ForeignKey('natureza_processo.id_natureza'), nullable=False)
    
    # Cliente
    cliente_id = Column(Integer, ForeignKey('clientes.id_cliente'))
    posicao_cliente_id = Column(Integer, ForeignKey('posicao_cliente.id_posicao'))
    
    # Classificação
    acao_id = Column(Integer, ForeignKey('acao.id_acao'))
    procedimento_id = Column(Integer, ForeignKey('procedimento.id_procedimento'))
    fase_id = Column(Integer, ForeignKey('fase_processual.id_fase'))
    
    # Localização
    orgao_id = Column(Integer, ForeignKey('orgao.id_orgao'))
    comarca_id = Column(Integer, ForeignKey('comarca.id_comarca'))
    vara_turma_id = Column(Integer, ForeignKey('vara_turma.id_vara_turma'))
    
    # CNJ
    justica_cnj_id = Column(Integer, ForeignKey('justica_cnj.id_justica'))
    instancia_cnj_id = Column(Integer, ForeignKey('instancia_cnj.id_instancia'))
    classe_cnj_id = Column(Integer, ForeignKey('classe_cnj.id_classe'))
    
    # Datas
    data_distribuicao = Column(Date)
    data_criacao = Column(TIMESTAMP, default=datetime.utcnow, nullable=False)
    data_atualizacao = Column(TIMESTAMP, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)
    
    # Valores
    valor_causa = Column(Numeric(18, 2))
    valor_causa_atualizado = Column(Numeric(18, 2))
    valor_envolvido = Column(Numeric(18, 2))
    valor_envolvido_atualizado = Column(Numeric(18, 2))
