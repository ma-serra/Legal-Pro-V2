import pandas as pd
import numpy as np
import re
from datetime import datetime
from decimal import Decimal
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

def limpar_valor_monetario(valor):
    """Remove R$, pontos e converte vírgula para ponto"""
    if pd.isna(valor):
        return None
    
    valor_str = str(valor)
    valor_limpo = valor_str.replace('R$', '').replace('.', '').replace(' ', '').strip()
    valor_limpo = valor_limpo.replace(',', '.')
    
    try:
        return Decimal(valor_limpo)
    except:
        return None

def validar_cnj(numero_cnj):
    """Valida formato do número CNJ"""
    if pd.isna(numero_cnj):
        return None
    
    padrao = r'^\d{7}-\d{2}\.\d{4}\.\d{1}\.\d{2}\.\d{4}$'
    numero_str = str(numero_cnj).strip()
    
    if re.match(padrao, numero_str):
        return numero_str
    return None

def normalizar_texto(texto):
    """Normaliza capitalização e remove espaços extras"""
    if pd.isna(texto):
        return None
    
    texto_limpo = str(texto).strip()
    texto_limpo = ' '.join(texto_limpo.split())
    return texto_limpo.title()

def validar_uf(uf):
    """Valida sigla de UF"""
    ufs_validas = ['AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 
                   'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 
                   'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO']
    
    if pd.isna(uf):
        return None
    
    uf_upper = str(uf).strip().upper()
    return uf_upper if uf_upper in ufs_validas else None

