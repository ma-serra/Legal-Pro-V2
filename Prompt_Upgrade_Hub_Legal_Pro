import React, { useEffect, useState } from 'react';
import Select from 'react-select';
import { TeseTributaria } from '../../../types/processos/tributario.types';

interface MultiSelectTesesProps {
  value: number[];
  onChange: (value: number[]) => void;
  endpoint?: string;
  error?: boolean;
}

