typescript// src/components/processos/DynamicForm/DynamicFormBuilder.tsx
import React, { useEffect, useState } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import * as z from 'zod';
import FieldRenderer from './FieldRenderer';
import ValidationSummary from './ValidationSummary';
import { FormSchema, FormSection } from '../../../types/processos/formulario.types';

interface DynamicFormBuilderProps {
  natureza: 'tributario' | 'trabalhista' | 'civel';
  initialData?: any;
  onSubmit: (data: any) => Promise<void>;
  onCancel: () => void;
}

const DynamicFormBuilder: React.FC<DynamicFormBuilderProps> = ({
  natureza,
  initialData,
  onSubmit,
  onCancel
}) => {
  const [schema, setSchema] = useState<FormSchema | null>(null);
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);

  // Buscar schema do backend
  useEffect(() => {
    const fetchSchema = async () => {
      try {
        const response = await fetch(`/api/processos/schema/${natureza}`);
        const data = await response.json();
        setSchema(data);
      } catch (error) {
        console.error('Erro ao carregar schema:', error);
      } finally {
        setLoading(false);
      }
    };

    fetchSchema();
  }, [natureza]);

  // Construir schema de validação Zod dinamicamente
  const buildValidationSchema = () => {
    if (!schema) return z.object({});

    const schemaObject: any = {};

    [...schema.campos_obrigatorios, ...schema.campos_opcionais].forEach(campo => {
      let fieldSchema;

      switch (campo.type) {
        case 'currency':
        case 'percentage':
          fieldSchema = z.number({
            required_error: `${campo.label} é obrigatório`,
            invalid_type_error: `${campo.label} deve ser um número`
          });
          
          if (campo.validation?.min !== undefined) {
            fieldSchema = fieldSchema.min(campo.validation.min, 
              `${campo.label} deve ser no mínimo ${campo.validation.min}`);
          }
          
          if (campo.validation?.max !== undefined) {
            fieldSchema = fieldSchema.max(campo.validation.max, 
              `${campo.label} deve ser no máximo ${campo.validation.max}`);
          }
          break;

        case 'text':
          fieldSchema = z.string();
          
          if (campo.validation?.maxLength) {
            fieldSchema = fieldSchema.max(campo.validation.maxLength, 
              `${campo.label} deve ter no máximo ${campo.validation.maxLength} caracteres`);
          }
          break;

        case 'date':
          fieldSchema = z.string().or(z.date());
          break;

        case 'select':
          fieldSchema = z.number().or(z.string());
          break;

        case 'multiselect':
          fieldSchema = z.array(z.number()).or(z.array(z.string()));
          break;

        default:
          fieldSchema = z.any();
      }

      // Campos opcionais
      if (!schema.campos_obrigatorios.some(c => c.name === campo.name)) {
        fieldSchema = fieldSchema.optional().nullable();
      }

      schemaObject[campo.name] = fieldSchema;
    });

    return z.object(schemaObject);
  };

  const validationSchema = buildValidationSchema();
  const methods = useForm({
    resolver: zodResolver(validationSchema),
    defaultValues: initialData || {}
  });

  const handleSubmit = async (data: any) => {
    setSubmitting(true);
    try {
      await onSubmit(data);
    } catch (error) {
      console.error('Erro ao submeter:', error);
    } finally {
      setSubmitting(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      </div>
    );
  }

  if (!schema) {
    return (
      <div className="text-center text-red-600">
        Erro ao carregar formulário
      </div>
    );
  }

  return (
    <FormProvider {...methods}>
      <form onSubmit={methods.handleSubmit(handleSubmit)} className="space-y-8">
        {/* Resumo de validações */}
        {Object.keys(methods.formState.errors).length > 0 && (
          <ValidationSummary errors={methods.formState.errors} />
        )}

        {/* Renderizar seções */}
        {schema.secoes.map((secao: FormSection, idx: number) => (
          <div key={idx} className="bg-white shadow rounded-lg p-6">
            <h3 className="text-lg font-semibold text-gray-900 mb-4">
              {secao.title}
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {secao.campos.map((nomeCampo: string) => {
                const campo = [...schema.campos_obrigatorios, ...schema.campos_opcionais]
                  .find(c => c.name === nomeCampo);

                if (!campo) return null;

                return (
                  <FieldRenderer
                    key={campo.name}
                    field={campo}
                    control={methods.control}
                    errors={methods.formState.errors}
                  />
                );
              })}
            </div>
          </div>
        ))}

        {/* Botões de ação */}
        <div className="flex justify-end space-x-4">
          <button
            type="button"
            onClick={onCancel}
            disabled={submitting}
            className="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 disabled:opacity-50"
          >
            Cancelar
          </button>
          <button
            type="submit"
            disabled={submitting}
            className="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 flex items-center"
          >
            {submitting && (
              <svg className="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            )}
            {submitting ? 'Salvando...' : 'Salvar Processo'}
          </button>
        </div>
      </form>
    </FormProvider>
  );
};

export default DynamicFormBuilder;
