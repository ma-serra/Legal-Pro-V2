            # Validar mínimo
            if 'min' in validacoes and isinstance(valor, (int, float, Decimal)):
                if valor < validacoes['min']:
                    erros.append(f"Campo '{campo['label']}' deve ser >= {validacoes['min']}")
            
            # Validar máximo
            if 'max' in validacoes and isinstance(valor, (int, float, Decimal)):
                if valor > validacoes['max']:
                    erros.append(f"Campo '{campo['label']}' deve ser <= {validacoes['max']}")
            
            # Validar tamanho máximo de string
            if 'maxLength' in validacoes and isinstance(valor, str):
                if len(valor) > validacoes['maxLength']:
                    erros.append(f"Campo '{campo['label']}' excede tamanho máximo de {validacoes['maxLength']} caracteres")
        
        return (len(erros) == 0, erros)
