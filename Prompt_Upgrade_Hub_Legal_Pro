sql-- =============================================
-- TABELA PRINCIPAL: processos
-- =============================================
CREATE TABLE processos (
    -- Identificação
    id_processo BIGSERIAL PRIMARY KEY,
    uuid UUID DEFAULT gen_random_uuid() UNIQUE NOT NULL,
    tenant_id INTEGER NOT NULL REFERENCES tenants(id_tenant) ON DELETE CASCADE,
    
    -- Dados Básicos (Comuns a todas as naturezas)
    numero_cnj VARCHAR(25),
    pasta VARCHAR(50),
    status_id INTEGER NOT NULL REFERENCES status_processo(id_status),
    natureza_id INTEGER NOT NULL REFERENCES natureza_processo(id_natureza),
    
    -- Cliente
    cliente_id INTEGER REFERENCES clientes(id_cliente),
    posicao_cliente_id INTEGER REFERENCES posicao_cliente(id_posicao),
    
    -- Classificação Jurídica
    acao_id INTEGER REFERENCES acao(id_acao),
    procedimento_id INTEGER REFERENCES procedimento(id_procedimento),
    fase_id INTEGER REFERENCES fase_processual(id_fase),
    
    -- Localização Processual
    orgao_id INTEGER REFERENCES orgao(id_orgao),
    comarca_id INTEGER REFERENCES comarca(id_comarca),
    vara_turma_id INTEGER REFERENCES vara_turma(id_vara_turma),
    
    -- CNJ
    justica_cnj_id INTEGER REFERENCES justica_cnj(id_justica),
    instancia_cnj_id INTEGER REFERENCES instancia_cnj(id_instancia),
    classe_cnj_id INTEGER REFERENCES classe_cnj(id_classe),
    
    -- Datas
    data_distribuicao DATE,
    data_criacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    data_atualizacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    
    -- Valores Base
    valor_causa NUMERIC(18,2),
    valor_causa_atualizado NUMERIC(18,2),
    valor_envolvido NUMERIC(18,2),
    valor_envolvido_atualizado NUMERIC(18,2),
    contingencia NUMERIC(18,2),
    
    -- Prognóstico Base
    tipo_probabilidade_id INTEGER REFERENCES tipo_probabilidade(id_tipo_probabilidade),
    risco_id INTEGER REFERENCES nivel_risco(id_risco),
    
    -- Metadados
    titulo TEXT,
    observacao_pasta TEXT,
    ativo BOOLEAN DEFAULT TRUE NOT NULL,
    
    -- Índices e Constraints
    CONSTRAINT chk_valores_positivos CHECK (
        valor_causa >= 0 AND 
        valor_causa_atualizado >= 0 AND 
        valor_envolvido >= 0 AND 
        valor_envolvido_atualizado >= 0 AND
        contingencia >= 0
    ),
    CONSTRAINT chk_valor_atualizado CHECK (
        valor_causa_atualizado >= valor_causa
    )
);

-- Índices para performance
