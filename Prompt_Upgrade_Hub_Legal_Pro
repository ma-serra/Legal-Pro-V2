from .models import Processo, ProcessoTributario, ProcessoTese
from ..atualizacao_monetaria.calculadora import CalculadoraMonetaria
from utils.validators.cnj_validator import validar_numero_cnj
from utils.converters.monetary_converter import limpar_valor_monetario

class ProcessoService:
    """Service para operações de processo"""
    
    def __init__(self, db: Session):
        self.db = db
    
    def criar_processo(self, dados: Dict[str, Any], tenant_id: int, user_id: int) -> Processo:
        """
        Cria um novo processo com validações e campos dinâmicos
        
        Args:
            dados: Dicionário com dados do processo
            tenant_id: ID do tenant (SaaS)
            user_id: ID do usuário criador
            
        Returns:
            Processo criado
            
        Raises:
            ValueError: Se validação falhar
            SQLAlchemyError: Se erro no banco
        """
        try:
            # Validar número CNJ se fornecido
            if dados.get('numero_cnj'):
                if not validar_numero_cnj(dados['numero_cnj']):
                    raise ValueError('Número CNJ inválido')
            
            # Validar natureza
            natureza_id = dados.get('natureza_id')
            if not natureza_id:
                raise ValueError('Natureza do processo é obrigatória')
            
            # Criar processo base
            processo = Processo(
                tenant_id=tenant_id,
                numero_cnj=dados.get('numero_cnj'),
                pasta=dados.get('pasta'),
                status_id=dados.get('status_id', 1),  # Default: Em andamento
                natureza_id=natureza_id,
                cliente_id=dados.get('cliente_id'),
                posicao_cliente_id=dados.get('posicao_cliente_id'),
                data_distribuicao=dados.get('data_distribuicao'),
                valor_causa=limpar_valor_monetario(dados.get('valor_causa')),
                titulo=dados.get('titulo'),
                observacao_pasta=dados.get('observacao_pasta')
            )
            
            self.db.add(processo)
            self.db.flush()  # Para obter o ID
            
            # Criar registros específicos conforme natureza
            if natureza_id == 1:  # Tributário
                self._criar_processo_tributario(processo.id_processo, dados.get('tributario', {}))
            elif natureza_id == 2:  # Trabalhista
                self._criar_processo_trabalhista(processo.id_processo, dados.get('trabalhista', {}))
            elif natureza_id == 3:  # Cível
                self._criar_processo_civel(processo.id_processo, dados.get('civel', {}))
            
            self.db.commit()
            
            return processo
            
        except SQLAlchemyError as e:
            self.db.rollback()
            raise e
    
    def _criar_processo_tributario(self, processo_id: int, dados: Dict[str, Any]):
        """Cria registro específico de processo tributário"""
        processo_trib = ProcessoTributario(
            processo_id=processo_id,
            tributo_id=dados.get('tributo_id'),
            numero_aiim=dados.get('numero_aiim'),
            numero_cda=dados.get('numero_cda'),
            data_lancamento=dados.get('data_lancamento'),
            valor_inscrito_cda=limpar_valor_monetario(dados.get('valor_inscrito_cda')),
            valor_principal=limpar_valor_monetario(dados.get('valor_principal')),
            valor_multa=limpar_valor_monetario(dados.get('valor_multa')),
            percentual_multa=dados.get('percentual_multa'),
            base_calculo_multa=dados.get('base_calculo_multa'),
            valor_juros=limpar_valor_monetario(dados.get('valor_juros')),
            indice_juros=dados.get('indice_juros'),
            vara_primeira_instancia_id=dados.get('vara_primeira_instancia_id'),
            turma_segunda_instancia_id=dados.get('turma_segunda_instancia_id')
        )
        
        self.db.add(processo_trib)
        
        # Vincular teses se fornecidas
        teses_ids = dados.get('teses_ids', [])
        for idx, tese_id in enumerate(teses_ids, 1):
            processo_tese = ProcessoTese(
                processo_id=processo_id,
                tese_id=tese_id,
                ordem=idx,
                status='Aguardando'
            )
            self.db.add(processo_tese)
    
    def atualizar_processo(self, processo_id: int, dados: Dict[str, Any], tenant_id: int) -> Processo:
        """Atualiza processo existente"""
        processo = self.db.query(Processo).filter(
            Processo.id_processo == processo_id,
            Processo.tenant_id == tenant_id,
            Processo.ativo == True
        ).first()
        
        if not processo:
            raise ValueError('Processo não encontrado')
        
        # Atualizar campos base
        for campo, valor in dados.items():
            if campo not in ['tributario', 'trabalhista', 'civel'] and hasattr(processo, campo):
                setattr(processo, campo, valor)
        
        # Atualizar campos específicos
        if processo.natureza_id == 1 and 'tributario' in dados:
            self._atualizar_processo_tributario(processo_id, dados['tributario'])
        
        processo.data_atualizacao = datetime.utcnow()
        self.db.commit()
        
        return processo
    
    def listar_processos(
        self, 
        tenant_id: int, 
        filtros: Dict[str, Any] = None,
        pagina: int = 1,
        por_pagina: int = 50
    ) -> Dict[str, Any]:
        """Lista processos com filtros e paginação"""
        query = self.db.query(Processo).filter(
            Processo.tenant_id == tenant_id,
            Processo.ativo == True
        )
        
        # Aplicar filtros
        if filtros:
            if 'natureza_id' in filtros:
                query = query.filter(Processo.natureza_id == filtros['natureza_id'])
            
            if 'status_id' in filtros:
                query = query.filter(Processo.status_id == filtros['status_id'])
            
            if 'cliente_id' in filtros:
                query = query.filter(Processo.cliente_id == filtros['cliente_id'])
            
            if 'numero_cnj' in filtros:
                query = query.filter(Processo.numero_cnj.ilike(f"%{filtros['numero_cnj']}%"))
        
        # Contar total
        total = query.count()
        
        # Paginar
        offset = (pagina - 1) * por_pagina
        processos = query.offset(offset).limit(por_pagina).all()
        
        return {
            'processos': [p.to_dict() for p in processos],
            'total': total,
            'pagina': pagina,
            'por_pagina': por_pagina,
            'total_paginas': (total + por_pagina - 1) // por_pagina
        }
    
    def obter_processo_completo(self, processo_id: int, tenant_id: int) -> Dict[str, Any]:
        """Obtém processo com todos os dados específicos"""
        processo = self.db.query(Processo).filter(
            Processo.id_processo == processo_id,
            Processo.tenant_id == tenant_id,
            Processo.ativo == True
        ).first()
        
        if not processo:
            raise ValueError('Processo não encontrado')
        
        return processo.to_dict_completo()
    
    def calcular_valores_atualizados(self, processo_id: int, tenant_id: int) -> Dict[str, Any]:
        """Calcula valores atualizados com correção monetária"""
        processo = self.db.query(Processo).filter(
            Processo.id_processo == processo_id,
            Processo.tenant_id == tenant_id
        ).first()
        
        if not processo or not processo.data_distribuicao:
            raise ValueError('Processo inválido ou sem data de distribuição')
        
        calculadora = CalculadoraMonetaria(self.db)
        
        # Calcular valor da causa atualizado
        if processo.valor_causa:
            resultado = calculadora.calcular_correcao(
                valor_base=processo.valor_causa,
                data_base=processo.data_distribuicao,
                data_final=datetime.now().date(),
                indice='IPCA'
            )
            
            processo.valor_causa_atualizado = resultado['valor_corrigido']
        
        # Para tributário, calcular também valores específicos
        if processo.natureza_id == 1 and processo.processo_tributario:
            trib = processo.processo_tributario
            if trib.valor_principal:
                resultado_principal = calculadora.calcular_correcao(
                    valor_base=trib.valor_principal,
                    data_base=trib.data_lancamento or processo.data_distribuicao,
                    data_final=datetime.now().date(),
                    indice=trib.indice_juros or 'SELIC'
                )
                # Atualizar valores
        
        self.db.commit()
        
        return processo.to_dict_completo()
