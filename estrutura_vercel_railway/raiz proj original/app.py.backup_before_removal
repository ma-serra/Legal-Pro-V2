    @app.route('/admin/api/logs')
    @admin_required
    def api_admin_logs():
        """
        API para obter logs recentes do sistema.
        """
        try:
            import os
            logs = []
            
            # Tentar ler logs do arquivo principal
            log_files = [
                'logs/app.log',
                'logs/multiagent.log',
                'logs/transcription.log'
            ]
            
            for log_file in log_files:
                if os.path.exists(log_file):
                    try:
                        with open(log_file, 'r', encoding='utf-8') as f:
                            lines = f.readlines()
                            # Pegar as últimas 50 linhas
                            for line in lines[-50:]:
                                if line.strip():
                                    parts = line.strip().split(' - ', 2)
                                    if len(parts) >= 3:
                                        logs.append({
                                            'timestamp': parts[0],
                                            'level': parts[1],
                                            'message': parts[2]
                                        })
                    except Exception as e:
                        logger.error(f"Erro ao ler {log_file}: {str(e)}")
            
            # Se não há logs de arquivos, usar logs em memória
            if not logs:
                import logging
                for handler in logging.getLogger().handlers:
                    if hasattr(handler, 'buffer'):
                        for record in handler.buffer[-20:]:
                            logs.append({
                                'timestamp': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(record.created)),
                                'level': record.levelname,
                                'message': record.getMessage()
                            })
            
            return jsonify({'success': True, 'logs': logs})
        except Exception as e:
            logger.error(f"Erro ao obter logs: {str(e)}")
            return jsonify({'success': False, 'logs': []})
    
