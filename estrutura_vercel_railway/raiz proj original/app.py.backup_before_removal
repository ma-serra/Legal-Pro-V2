    @app.route('/fluxos/executar', methods=['POST'], strict_slashes=False)
    @login_required
    def executar_fluxo():
        """
        API para executar um fluxo e retornar resultados em streaming.
        """
        try:
            data = request.get_json()
            
            if not data:
                return jsonify({'success': False, 'message': 'Dados não fornecidos'}), 400
            
            fluxo_id = data.get('fluxo_id')
            input_text = data.get('input_text', '').strip()
            execution_mode = data.get('execution_mode', 'sequential')
            verbose_mode = data.get('verbose_mode', True)
            
            if not input_text:
                return jsonify({'success': False, 'message': 'Texto de entrada é obrigatório'}), 400
            
            def generate_execution_stream():
                """Gera stream de execução simulada"""
                import time
                import random
                
                # Simulação de execução
                yield f"data: {json.dumps({'type': 'log', 'message': 'Iniciando execução do fluxo...', 'level': 'info'})}\n\n"
                time.sleep(1)
                
                yield f"data: {json.dumps({'type': 'log', 'message': 'Carregando componentes...', 'level': 'info'})}\n\n"
                time.sleep(1)
                
                yield f"data: {json.dumps({'type': 'progress', 'step': 1, 'total': 5})}\n\n"
                time.sleep(1)
                
                yield f"data: {json.dumps({'type': 'log', 'message': 'Processando texto de entrada...', 'level': 'info'})}\n\n"
                time.sleep(2)
                
                yield f"data: {json.dumps({'type': 'progress', 'step': 3, 'total': 5})}\n\n"
                time.sleep(1)
                
                yield f"data: {json.dumps({'type': 'log', 'message': 'Aplicando transformações...', 'level': 'info'})}\n\n"
                time.sleep(1)
                
                yield f"data: {json.dumps({'type': 'progress', 'step': 5, 'total': 5})}\n\n"
                time.sleep(1)
                
                # Resultado simulado
                resultado = {
                    'texto_processado': input_text.upper(),
                    'sentimento': 'positivo' if random.random() > 0.5 else 'neutro',
                    'confianca': round(random.uniform(0.7, 0.95), 2),
                    'palavras_chave': ['documento', 'processamento', 'análise'],
                    'tempo_execucao': '3.2s'
                }
                
                yield f"data: {json.dumps({'type': 'result', 'data': resultado})}\n\n"
                yield f"data: {json.dumps({'type': 'log', 'message': 'Execução concluída com sucesso!', 'level': 'success'})}\n\n"
            
            return Response(
                generate_execution_stream(),
                mimetype='text/plain',
                headers={'Cache-Control': 'no-cache'}
            )
            
        except Exception as e:
            return jsonify({'success': False, 'message': f'Erro na execução: {str(e)}'}), 500
    

    
