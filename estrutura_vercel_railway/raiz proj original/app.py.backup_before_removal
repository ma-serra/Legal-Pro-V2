                'gpt-4-turbo',
                'claude-3-5-sonnet-20241022',
                'claude-3-haiku-20240307',
                'gemini-1.5-pro',
                'gemini-1.5-flash',
                'deepseek-chat',
                'llama-3.1-sonar-small-128k-online'
            ]
            
            try:
