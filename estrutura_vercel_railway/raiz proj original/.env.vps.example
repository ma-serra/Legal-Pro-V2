# Legal Design Pro V2 - Configuração para VPS Hostinger
# Copie este arquivo para .env e configure suas chaves

# Configurações básicas da aplicação
FLASK_ENV=production
FLASK_SECRET_KEY=sua_chave_secreta_muito_segura_aqui_123456789
DATABASE_URL=postgresql://legaldesign:LegalDesign2025!@#@localhost/legal_design_pro_v2

# APIs de IA (OBRIGATÓRIAS)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-sua_chave_anthropic_aqui

# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_google_gemini_aqui

# Qdrant Cloud (OBRIGATÓRIO para base vetorial)
# Obtenha em: https://cloud.qdrant.io/
QDRANT_URL=https://sua_instancia_id.qdrant.cloud:6333
QDRANT_API_KEY=sua_chave_qdrant_aqui

# AssemblyAI (OBRIGATÓRIO para transcrição)
# Obtenha em: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=sua_chave_assemblyai_aqui

# DeepSeek (OPCIONAL)
DEEPSEEK_API_KEY=sk-sua_chave_deepseek_aqui

# Taskade (OPCIONAL)
TASKADE_API_KEY=sua_chave_taskade_aqui

# Redis para cache (OPCIONAL - melhora performance)
REDIS_URL=redis://localhost:6379

# Configurações de produção
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300
GUNICORN_KEEPALIVE=2

# Configurações de segurança
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour

# Configurações de logs
LOG_LEVEL=INFO
LOG_FILE=/home/legaldesign/logs/app.log

# Configurações de backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Todo dia às 2:00

# Configurações de monitoramento
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=300

# Timezone
TZ=America/Sao_Paulo