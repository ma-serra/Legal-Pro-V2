# Exemplo de variáveis de ambiente para Legal Design Pro V2
# Copie este arquivo para .env e configure os valores reais

# Configuração da aplicação
SESSION_SECRET=sua_chave_secreta_aqui_min_32_caracteres
FLASK_SECRET_KEY=outra_chave_secreta_diferente_32_chars
FLASK_ENV=production
DEBUG=False

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:porta/database

# APIs de IA - Configure pelo menos OpenAI
OPENAI_API_KEY=sk-sua_chave_openai_aqui
ANTHROPIC_API_KEY=sk-ant-sua_chave_anthropic_aqui
GOOGLE_API_KEY=sua_chave_google_ai_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# Transcrição de áudio
ASSEMBLYAI_API_KEY=sua_chave_assemblyai_aqui

# Banco vetorial Qdrant
QDRANT_URL=https://sua_instancia_qdrant.cloud
QDRANT_API_KEY=sua_chave_qdrant_aqui
QDRANT_COLLECTION_NAME=legal_documents

# Configurações opcionais
REDIS_URL=redis://localhost:6379/0
TASKADE_API_TOKEN=sua_chave_taskade_aqui

# Configurações de rate limiting
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# Configurações de upload
MAX_CONTENT_LENGTH=209715200
UPLOAD_FOLDER=uploads
TEMP_FOLDER=temp

# Configurações de logs
LOG_LEVEL=INFO