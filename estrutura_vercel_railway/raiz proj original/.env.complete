# ================================
# LEGAL DESIGN PRO V2 - CONFIGURAÇÕES COMPLETAS
# Sistema Jurídico Multi-Agente
# ================================

# === CONFIGURAÇÕES ESSENCIAIS DO FLASK ===
FLASK_ENV=production
FLASK_APP=main.py
DEBUG=False
SECRET_KEY=sua_chave_secreta_muito_segura_32_caracteres_minimo_aqui
SESSION_SECRET=sua_chave_secreta_muito_segura_32_caracteres_minimo_aqui

# === BANCO DE DADOS PRINCIPAL ===
# PostgreSQL com extensão pgvector
DATABASE_URL=postgresql://legaldesign:senha_super_segura_123@localhost:5432/legal_design_pro_v2

# === CACHE E SESSÕES ===
# Redis para cache e gerenciamento de sessões
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1

# === APIs DE INTELIGÊNCIA ARTIFICIAL (OBRIGATÓRIAS) ===

# OpenAI - API Principal para GPT-4o e Whisper
OPENAI_API_KEY=sk-sua_chave_openai_aqui_comeca_com_sk
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

# Anthropic - Claude 3.5 Sonnet para análises alternativas
ANTHROPIC_API_KEY=sk-ant-sua_chave_anthropic_aqui_comeca_com_sk_ant
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google AI - Gemini para análises complementares
GOOGLE_API_KEY=sua_chave_google_ai_aqui
GOOGLE_MODEL=gemini-1.5-pro

# DeepSeek - API adicional para redundância
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat

# === TRANSCRIÇÃO DE ÁUDIO E VÍDEO ===
# AssemblyAI - Serviço principal de transcrição
ASSEMBLYAI_API_KEY=sua_chave_assemblyai_aqui

# === BANCO VETORIAL ===
# Qdrant Cloud - Banco vetorial para busca semântica
QDRANT_URL=https://sua_instancia_qdrant_cloud.qdrant.io
QDRANT_API_KEY=sua_chave_qdrant_aqui
QDRANT_COLLECTION_NAME=legal_design_embeddings

# === CONFIGURAÇÕES DE PRODUÇÃO ===
# Gunicorn Workers
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
TIMEOUT=300
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
BIND=0.0.0.0:8000

# === DIRETÓRIOS E CAMINHOS ===
# Diretórios para uploads e processamento
UPLOAD_FOLDER=/home/legaldesign/apps/legal-design-pro-v2/uploads
TEMP_FOLDER=/home/legaldesign/apps/legal-design-pro-v2/temp
LOG_FOLDER=/home/legaldesign/apps/legal-design-pro-v2/logs
EXPORT_FOLDER=/home/legaldesign/apps/legal-design-pro-v2/static/exports
STATIC_FOLDER=/home/legaldesign/apps/legal-design-pro-v2/static

# === CONFIGURAÇÕES DE SEGURANÇA ===
# Security Headers
WERKZEUG_DEBUG_PIN=off
SEND_FILE_MAX_AGE_DEFAULT=31536000
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CORS
CORS_ORIGINS=https://seu_dominio.com,https://www.seu_dominio.com

# === CONFIGURAÇÕES DE UPLOAD ===
# Limites de arquivo
MAX_CONTENT_LENGTH=104857600  # 100MB
ALLOWED_EXTENSIONS=pdf,docx,txt,mp3,wav,m4a,ogg,mp4,avi,mov

# === CONFIGURAÇÕES DE EMAIL (OPCIONAL) ===
# Para notificações e recuperação de senha
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_app_gmail

# === CONFIGURAÇÕES DE LOGGING ===
# Níveis de log
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# === CONFIGURAÇÕES DE RATE LIMITING ===
# Proteção contra abuso
RATELIMIT_STORAGE_URL=redis://localhost:6379/2
RATELIMIT_DEFAULT=100/hour
RATELIMIT_HEADERS_ENABLED=True

# === CONFIGURAÇÕES DE ANÁLISE MULTI-AGENTE ===
# Timeouts e limites para análises
ANALYSIS_TIMEOUT=300
MAX_AGENTS_PER_ANALYSIS=3
DEFAULT_ANALYSIS_TOKENS=4000

# === CONFIGURAÇÕES DE MACHINE LEARNING ===
# Jurimetria e análises preditivas
ML_MODEL_PATH=/home/legaldesign/apps/legal-design-pro-v2/ml_models
ML_CACHE_TTL=3600
ML_MAX_FEATURES=10000

# === CONFIGURAÇÕES DE BACKUP ===
# Backup automático
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Diário às 2:00
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/home/legaldesign/backups

# === CONFIGURAÇÕES DE MONITORAMENTO ===
# Métricas e monitoramento
MONITORING_ENABLED=True
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_ENDPOINT=/health

# === CONFIGURAÇÕES DE CELERY (TAREFAS ASSÍNCRONAS) ===
# Para processamento em background
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=America/Sao_Paulo

# === CONFIGURAÇÕES ESPECÍFICAS POR MÓDULO ===

# Transcrição
TRANSCRIPTION_MAX_DURATION=3600  # 1 hora
TRANSCRIPTION_CHUNK_SIZE=25000000  # 25MB

# Mapas Mentais
MINDMAP_MAX_NODES=100
MINDMAP_TIMEOUT=120

# Templates Jurídicos
TEMPLATE_CACHE_TTL=1800  # 30 minutos
TEMPLATE_MAX_SIZE=1048576  # 1MB

# Comparação de Documentos
COMPARISON_MAX_SIZE=10485760  # 10MB
COMPARISON_TIMEOUT=180

# === CONFIGURAÇÕES DE DESENVOLVIMENTO (REMOVER EM PRODUÇÃO) ===
# Apenas para desenvolvimento local
# FLASK_ENV=development
# DEBUG=True
# TESTING=False

# === CONFIGURAÇÕES OPCIONAIS ===

# Taskade Integration (se usar)
TASKADE_API_TOKEN=sua_chave_taskade_aqui

# Webhooks (se necessário)
WEBHOOK_SECRET=sua_chave_webhook_aqui

# Analytics (se usar)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Sentry para error tracking (recomendado)
SENTRY_DSN=https://sua_chave_sentry_aqui

# === CONFIGURAÇÕES DE TIMEZONE ===
TIMEZONE=America/Sao_Paulo
USE_TZ=True

# === CONFIGURAÇÕES DE IDIOMA ===
LANGUAGE_CODE=pt-br
LANGUAGES=pt-br,en-us

# === CONFIGURAÇÕES DE THREAD POOL ===
# Para processamento paralelo
THREAD_POOL_SIZE=10
MAX_CONCURRENT_REQUESTS=20

# === CONFIGURAÇÕES DE SSL/TLS (VPS) ===
# Configurações para HTTPS
SSL_CERT_PATH=/etc/letsencrypt/live/seu_dominio.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/seu_dominio.com/privkey.pem

# === VARIÁVEIS DE AMBIENTE DO SISTEMA ===
# Configurações do sistema operacional
LANG=pt_BR.UTF-8
LC_ALL=pt_BR.UTF-8
TZ=America/Sao_Paulo

# === CONFIGURAÇÕES DE PERFORMANCE ===
# Otimizações de performance
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_ENGINE_OPTIONS_POOL_PRE_PING=True

# === CONFIGURAÇÕES ESPECÍFICAS PARA VPS ===
# Configurações específicas para deploy em VPS
SERVER_NAME=seu_dominio.com
PREFERRED_URL_SCHEME=https
APPLICATION_ROOT=/

# === CONFIGURAÇÕES DE DESENVOLVIMENTO E DEBUG ===
# Para troubleshooting (desabilitar em produção)
SQLALCHEMY_ECHO=False
WERKZEUG_RUN_MAIN=True
PROPAGATE_EXCEPTIONS=True

# ================================
# FIM DAS CONFIGURAÇÕES
# ================================

# INSTRUÇÕES:
# 1. Substitua TODOS os valores de exemplo pelas suas configurações reais
# 2. Mantenha este arquivo seguro - nunca commite no Git
# 3. Use senhas fortes com pelo menos 32 caracteres
# 4. Configure SSL/HTTPS em produção
# 5. Monitore logs regularmente
# 6. Faça backup das configurações

# CHAVES OBRIGATÓRIAS PARA FUNCIONAMENTO:
# - SESSION_SECRET (32+ caracteres)
# - DATABASE_URL (PostgreSQL com pgvector)
# - OPENAI_API_KEY (para GPT-4o e Whisper)
# - ASSEMBLYAI_API_KEY (para transcrição)
# - QDRANT_URL e QDRANT_API_KEY (para busca vetorial)

# CHAVES RECOMENDADAS:
# - ANTHROPIC_API_KEY (para análises alternativas)
# - GOOGLE_API_KEY (para análises complementares)
# - REDIS_URL (para performance)
# - MAIL_* (para notificações)